{
  "name": "@tshirt/point-desktop",
  "version": "1.0.24",
  "private": true,
  "description": "Windows desktop shell for the operator PC (point-server + operator UI)",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.tshirtprinter.operator",
    "productName": "Tshirt Printer Operator",
    "copyright": "Copyright © Tshirt Printer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "modules.cjs",
      "moduleUpdater.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "by-23",
        "repo": "TshirtPrinterApp",
        "channel": "operator"
      }
    ],
    "extraResources": [
      {
        "from": "resources/point-server",
        "to": "point-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/point-server/node_modules",
        "to": "point-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "executableName": "TshirtPrinterOperator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TshirtPrinterOperator-Setup-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tshirt Printer Operator",
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
