{
  "name": "@tshirt/central-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "@tshirt/shared-types": "workspace:*",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "heic-convert": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
