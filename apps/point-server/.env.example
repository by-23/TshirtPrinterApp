PORT=4000
DATABASE_PATH=./data/point.db

# Optional — without these the point runs fully offline (fail-open).
# Copy id + syncToken from admin panel (POST /points response) or central-relay seed output.
CENTRAL_RELAY_URL=http://localhost:4100
POINT_SYNC_ID=
POINT_SYNC_TOKEN=

# Optional — fallback Giphy API key when not set in the operator panel
# (docs/PLAN.md Этап 3). Panel value overrides this. Without any key, the
# scraper just falls back to Pinterest only (fail-open). Free key, no card:
# https://developers.giphy.com/dashboard/ → "Create an App" → "API" (not "SDK").
GIPHY_API_KEY=

# Optional — Pollinations bearer token for standard AI stylization.
POLLINATIONS_API_TOKEN=

# Optional — premium AI stylization (ChatGPT / Gemini). When unset, that
# provider is hidden on the kiosk "Выберите стиль" screen.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional — LAN host:port for QR photo upload in wifi mode (e.g. 192.168.1.13:4000).
PUBLIC_LAN_HOST=
